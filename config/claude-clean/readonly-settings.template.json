{
  "_comment": "Merged into claude-clean's --settings by scripts/claude-wrap.mjs, ONLY for read-only permission modes (plan, default). No allow rules: a read inside the task folder is native, every other read raises a permission the router judges (readguard). Tools that write or reach out are denied; deny beats any project or user allow. Superset of readguard SENSITIVE_GLOBS (a test checks). hub.mjs appends the real PASEO_HOME denies.",
  "permissions": {
    "deny": [
      "Bash",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__*",
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.*)",
      "Read(**/.env.*)",
      "Read(credentials*)",
      "Read(**/credentials*)",
      "Read(creds*)",
      "Read(**/creds*)",
      "Read(*secret*)",
      "Read(**/*secret*)",
      "Read(*.pem)",
      "Read(**/*.pem)",
      "Read(*.key)",
      "Read(**/*.key)",
      "Read(*.p12)",
      "Read(**/*.p12)",
      "Read(*.pfx)",
      "Read(**/*.pfx)",
      "Read(*.jks)",
      "Read(**/*.jks)",
      "Read(*.keystore)",
      "Read(**/*.keystore)",
      "Read(id_rsa*)",
      "Read(**/id_rsa*)",
      "Read(id_ed25519*)",
      "Read(**/id_ed25519*)",
      "Read(id_ecdsa*)",
      "Read(**/id_ecdsa*)",
      "Read(id_dsa*)",
      "Read(**/id_dsa*)",
      "Read(.*)",
      "Read(**/.*)",
      "Read(.*/**)",
      "Read(**/.*/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/**)",
      "Read(~/.codex/**)",
      "Read(~/.qoder/**)",
      "Read(~/.aws/**)",
      "Read(~/.paseo/agent-hub-secret)",
      "Read(~/.paseo/config.json)",
      "Read(~/.paseo/hub/**)"
    ]
  }
}
