{
  "_comment": "Default provider order per task type. A caller may override the provider and the gate. A busy or failed entry moves to the next one. The chains are the section 24 proposal and are replaced by the bench result; copy to routes.local.json and replace the <PLACEHOLDERS>. Each entry is provider/model as the daemon config names them.",
  "gateDefault": "<REPO_GATE_COMMAND>",
  "gates": [
    { "match": "<REPO_PATH_REGEX>", "cmd": "<REPO_GATE_COMMAND>", "maxLines": 400, "forbid": "^([.]env|[.]github/|.*[.]pem$)" }
  ],
  "slots": { "codex": 2, "claude-clean": 2, "qoder": 1, "qwen-office": 2, "qwen-laptop": 1 },
  "waitTimeout": "10m",
  "routes": {
    "code-edit": ["codex/gpt-6.1-terra", "codex/gpt-6.1-sol", "claude-clean/<CLAUDE_SONNET_MODEL>", "qwen-office/<OFFICE_MODEL>"],
    "code-edit-easy": ["qwen-laptop/<LAPTOP_MODEL>", "qwen-office/<OFFICE_MODEL>", "codex/gpt-6-luna"],
    "summarise": ["qwen-laptop/<LAPTOP_MODEL>", "qwen-office/<OFFICE_MODEL>", "codex/gpt-6-luna"],
    "test-scaffold": ["qwen-laptop/<LAPTOP_MODEL>", "codex/gpt-6.1-sol", "claude-clean/<CLAUDE_HAIKU_MODEL>"],
    "review": ["qwen-laptop/<LAPTOP_MODEL>", "qwen-office/<OFFICE_MODEL>", "claude-clean/<CLAUDE_HAIKU_MODEL>"]
  }
}
