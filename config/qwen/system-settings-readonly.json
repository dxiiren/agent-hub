{
  "memory": {
    "enableManagedAutoMemory": false,
    "enableManagedAutoDream": false
  },
  "$version": 4,
  "_comment": "System settings for the read-only Qwen twin providers (qwen-*-ro, launched with --read-only): auto-memory off plus a deny list (sensitive Read globs from the claude read-only template, shell/write/recursive-read tools). Plan mode lets Qwen read an in-cwd .env without a permission request, so the CLI itself must refuse it. Shell is not denied but ASKED on every call: the hub (readguard.mjs commandAllowed) approves only read commands (grep/rg, sed -n, head, tail, cat, ls, wc, find without -exec/-delete) whose file arguments pass the same path rules as Read; everything else is denied. Sub-agent tools are denied.",
  "permissions": {
    "deny": [
      "Edit",
      "Write",
      "ReadManyFiles",
      "Grep",
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.*)",
      "Read(**/.env.*)",
      "Read(credentials*)",
      "Read(**/credentials*)",
      "Read(creds*)",
      "Read(**/creds*)",
      "Read(*secret*)",
      "Read(**/*secret*)",
      "Read(*.pem)",
      "Read(**/*.pem)",
      "Read(*.key)",
      "Read(**/*.key)",
      "Read(*.p12)",
      "Read(**/*.p12)",
      "Read(*.pfx)",
      "Read(**/*.pfx)",
      "Read(*.jks)",
      "Read(**/*.jks)",
      "Read(*.keystore)",
      "Read(**/*.keystore)",
      "Read(id_rsa*)",
      "Read(**/id_rsa*)",
      "Read(id_ed25519*)",
      "Read(**/id_ed25519*)",
      "Read(id_ecdsa*)",
      "Read(**/id_ecdsa*)",
      "Read(id_dsa*)",
      "Read(**/id_dsa*)",
      "Read(.*)",
      "Read(**/.*)",
      "Read(.*/**)",
      "Read(**/.*/**)",
      "Read(~/.ssh/**)",
      "Read(~/.claude/**)",
      "Read(~/.codex/**)",
      "Read(~/.qoder/**)",
      "Read(~/.aws/**)",
      "Read(~/.paseo/agent-hub-secret)",
      "Read(~/.paseo/config.json)",
      "Read(~/.paseo/hub/**)",
      "ReadFile(.env)",
      "ReadFile(**/.env)",
      "ReadFile(.env.*)",
      "ReadFile(**/.env.*)",
      "ReadFile(credentials*)",
      "ReadFile(**/credentials*)",
      "ReadFile(creds*)",
      "ReadFile(**/creds*)",
      "ReadFile(*secret*)",
      "ReadFile(**/*secret*)",
      "ReadFile(*.pem)",
      "ReadFile(**/*.pem)",
      "ReadFile(*.key)",
      "ReadFile(**/*.key)",
      "ReadFile(*.p12)",
      "ReadFile(**/*.p12)",
      "ReadFile(*.pfx)",
      "ReadFile(**/*.pfx)",
      "ReadFile(*.jks)",
      "ReadFile(**/*.jks)",
      "ReadFile(*.keystore)",
      "ReadFile(**/*.keystore)",
      "ReadFile(id_rsa*)",
      "ReadFile(**/id_rsa*)",
      "ReadFile(id_ed25519*)",
      "ReadFile(**/id_ed25519*)",
      "ReadFile(id_ecdsa*)",
      "ReadFile(**/id_ecdsa*)",
      "ReadFile(id_dsa*)",
      "ReadFile(**/id_dsa*)",
      "ReadFile(.*)",
      "ReadFile(**/.*)",
      "ReadFile(.*/**)",
      "ReadFile(**/.*/**)",
      "ReadFile(~/.ssh/**)",
      "ReadFile(~/.claude/**)",
      "ReadFile(~/.codex/**)",
      "ReadFile(~/.qoder/**)",
      "ReadFile(~/.aws/**)",
      "ReadFile(~/.paseo/agent-hub-secret)",
      "ReadFile(~/.paseo/config.json)",
      "ReadFile(~/.paseo/hub/**)",
      "Task",
      "Agent",
      "agent",
      "task"
    ],
    "ask": [
      "run_shell_command"
    ]
  }
}
