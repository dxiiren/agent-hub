# Claude Code — per-dev secrets & local overrides (NEVER commit)
# Real MCP config holds live tokens; commit .mcp.json.stub instead.
.mcp.json
.claude/settings.local.json
.claude/workspace/

# Environment files hold real secrets; commit .env.example as the template.
.env
.env.*
!.env.example

# agent-hub local secrets and machine config (never commit)
*.local.*
credentials*
*.pem
*.key
.env*
!.env.example
config/local/

# deploy stacks: keep the templates, never the filled files
!.env.template
deploy/usage/targets/*.yml
deploy/shared/env/*.env
deploy/shared/.env
__pycache__/
