#!/bin/sh
d=$(cd "$(dirname "$0")" && { pwd -W 2>/dev/null || pwd; })
case "$2" in --help|-h|help) exec node "$d/../../../scripts/help.mjs" "$1" ;; esac
case "$1" in
  ""|--help|-h|help) exec node "$d/../../../scripts/help.mjs" ;;
  usage) exec python3 -S -E "$d/agent_hub_usage.py" "$@" ;;
  doctor) shift; exec node "$d/../../../scripts/hub.mjs" doctor "$@" ;;
  provider) shift; exec node "$d/../../../scripts/hub.mjs" provider "$@" ;;
  routes) shift; exec node "$d/../../../scripts/hub.mjs" routes "$@" ;;
  route) shift; exec node "$d/../../routing/route.mjs" "$@" ;;
  cleanup) shift; exec node "$d/../../routing/cleanup.mjs" "$@" ;;
  reply) exec node "$d/../../routing/route.mjs" "$@" ;;
  *) node "$d/../../../scripts/help.mjs" "$1" >&2; exit 2 ;;
esac
